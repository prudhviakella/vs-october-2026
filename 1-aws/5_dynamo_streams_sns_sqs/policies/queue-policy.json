{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowTopicToSend",
      "Effect": "Allow",
      "Principal": { "Service": "sns.amazonaws.com" },
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:us-east-1:ACCOUNT_ID:it-onboarding",
      "Condition": { "ArnEquals": { "aws:SourceArn": "arn:aws:sns:us-east-1:ACCOUNT_ID:new-employee" } }
    }
  ]
}
